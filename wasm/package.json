{
  "name": "@franken-suite/franken-markdown",
  "version": "0.4.5",
  "description": "Browser/WASM package for franken_markdown Markdown to HTML/PDF rendering.",
  "type": "module",
  "sideEffects": [
    "./fmd-view.js",
    "./flow_worker.js"
  ],
  "license": "LicenseRef-MIT-OpenAI-Anthropic-Rider",
  "author": "Jeffrey Emanuel",
  "homepage": "https://github.com/Dicklesworthstone/franken_markdown#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dicklesworthstone/franken_markdown.git",
    "directory": "wasm"
  },
  "bugs": {
    "url": "https://github.com/Dicklesworthstone/franken_markdown/issues"
  },
  "keywords": [
    "markdown",
    "pdf",
    "html",
    "renderer",
    "wasm",
    "webassembly",
    "typesetting"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "exports": {
    ".": {
      "types": "./franken_markdown.d.ts",
      "import": "./franken_markdown.js"
    },
    "./book": {
      "types": "./book.d.ts",
      "import": "./book.js"
    },
    "./web-component": {
      "types": "./fmd-view.d.ts",
      "import": "./fmd-view.js"
    },
    "./flow": {
      "types": "./flow.d.ts",
      "import": "./flow.js"
    },
    "./flow-worker": {
      "types": "./flow-worker.d.ts",
      "import": "./flow-worker.js"
    },
    "./flow-worker/worker": "./flow_worker.js",
    "./flow-canvas": {
      "types": "./flow-canvas.d.ts",
      "import": "./flow-canvas.js"
    },
    "./flow-assets": {
      "types": "./flow-assets.d.ts",
      "import": "./flow-assets.js"
    },
    "./flow-reader": {
      "types": "./flow-reader.d.ts",
      "import": "./flow-reader.js"
    }
  },
  "files": [
    "franken_markdown.js",
    "franken_markdown.d.ts",
    "book.js",
    "book.d.ts",
    "book_session.mjs",
    "demo/index.html",
    "demo/demo.js",
    "pkg/franken_markdown.js",
    "pkg/franken_markdown_bg.wasm",
    "pkg/franken_markdown_bg.wasm.d.ts",
    "pkg/franken_markdown.d.ts",
    "fmd-view.js",
    "fmd-view.d.ts",
    "flow.js",
    "flow.d.ts",
    "flow_session.mjs",
    "FLOW.md",
    "flow-worker.js",
    "flow-worker.d.ts",
    "flow_worker.js",
    "flow_worker_session.mjs",
    "flow_worker_protocol.mjs",
    "worker_transport.mjs",
    "WORKER.md",
    "flow_outlines.mjs",
    "flow-canvas.js",
    "flow-canvas.d.ts",
    "CANVAS.md",
    "demo/flow-canvas.html",
    "demo/flow-canvas.js",
    "demo/flow_preview_controller.mjs",
    "flow-assets.js",
    "flow-assets.d.ts",
    "flow_raster.mjs",
    "ASSETS.md",
    "demo/local_image_sources.mjs",
    "flow-reader.js",
    "flow-reader.d.ts",
    "flow_reading.mjs",
    "READER.md",
    "demo/flow_reading_controls.mjs"
  ]
}
